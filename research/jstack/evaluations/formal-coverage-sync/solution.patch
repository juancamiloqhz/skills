+#!/usr/bin/env python3
+"""Generated-input testing of the real parse_limit implementation; no proof claim."""
+import argparse
+import hashlib
+import itertools
+import json
+from pathlib import Path
+import random
+import subprocess
+import sys
+import tempfile
+
+HERE = Path(__file__).resolve().parent
+PROJECT = HERE.parents[2]
+
+
+class Failure(Exception):
+    def __init__(self, detail):
+        self.detail = detail
+
+
+def check(source):
+    namespace = {'__name__': 'limits_under_check'}
+    exec(compile(source.read_bytes(), str(source), 'exec'), namespace)
+    parse = namespace['parse_limit']
+    counts = {}
+
+    def case(value, group):
+        # Independent grammar oracle: no isascii/isdecimal/int delegation.
+        valid = isinstance(value, str) and 1 <= len(value) <= 3
+        number = 0
+        if valid:
+            for char in value:
+                digit = ord(char) - ord('0')
+                if not 0 <= digit <= 9:
+                    valid = False
+                    break
+                number = number * 10 + digit
+            valid = valid and 1 <= number <= 255
+        counts[group] = counts.get(group, 0) + 1
+        expected = {'return': number} if valid else {'exception': 'ValueError'}
+        try:
+            actual_value = parse(value)
+        except Exception as error:
+            actual = {'exception': type(error).__name__}
+            good = not valid and isinstance(error, ValueError)
+        else:
+            actual = {'return': repr(actual_value), 'type': type(actual_value).__name__}
+            good = valid and type(actual_value) is int and actual_value == number
+        if not good:
+            raise Failure({'group': group, 'input': repr(value), 'expected': expected, 'actual': actual})
+
+    class Coercible:
+        def __str__(self):
+            return '1'
+        def __int__(self):
+            return 1
+
+    for value in [None, True, False, -1, 0, 1, 255, 256, 1.0, float('nan'),
+                  float('inf'), b'1', bytearray(b'1'), memoryview(b'1'), [],
+                  ['1'], {}, {'value': '1'}, (), ('1',), {1}, range(1), Coercible(), object()]:
+        case(value, 'non_string_samples')
+    for value in ['', '0', '00', '000', '1', '01', '001', '9', '99', '255',
+                  '256', '999', '0001', '0255', '1000', '+1', '-1', ' 1', '1 ',
+                  '1\n', '1\x00', '1_0', '1.0', '\u0661', '\uff11', '\u00b2']:
+        case(value, 'boundary_samples')
+
+    accepted = []
+    for length in range(1, 4):
+        for chars in itertools.product('0123456789', repeat=length):
+            value = ''.join(chars)
+            case(value, 'decimal_strings_length_1_to_3')
+            if 1 <= int(value) <= 255:
+                accepted.append(value)
+    for chars in itertools.product('0123456789', repeat=4):
+        case(''.join(chars), 'decimal_strings_length_4')
+
+    # Every ASCII string in this finite length bound, including control bytes.
+    ascii_chars = tuple(map(chr, range(128)))
+    for length in range(4):
+        for chars in itertools.product(ascii_chars, repeat=length):
+            case(''.join(chars), 'ascii_strings_length_0_to_3')
+
+    # Includes surrogates. Inputs never need to be encoded to call parse_limit.
+    unicode_digits = []
+    for point in range(sys.maxunicode + 1):
+        char = chr(point)
+        case(char, 'all_single_unicode_codepoints')
+        if point >= 128 and char.isdecimal():
+            unicode_digits.append(char)
+    for word in accepted:
+        for position in range(len(word)):
+            for char in unicode_digits:
+                case(word[:position] + char + word[position + 1:],
+                     'non_ascii_decimal_substitutions_in_every_valid_word')
+
+    randomizer = random.Random(20261025)
+    alphabet = '0123456789+- _\t\n\x00abc\u0661\uff11\u00b2\U0001f600'
+    for _ in range(10000):
+        value = ''.join(randomizer.choice(alphabet) for _ in range(randomizer.randrange(65)))
+        case(value, 'seeded_mixed_strings_length_0_to_64')
+    for length in [5, 10, 100, 1000, 10000]:
+        for value in ['0' * (length - 1) + '1', '9' * length, '\u0661' * length]:
+            case(value, 'long_string_samples')
+    return {'status': 'pass', 'cases': sum(counts.values()), 'groups': counts,
+            'accepted_spellings': len(accepted), 'non_ascii_decimal_codepoints': len(unicode_digits),
+            'source_sha256': hashlib.sha256(source.read_bytes()).hexdigest()}
+
+
+def run(source):
+    try:
+        return check(source)
+    except Failure as failure:
+        return {'status': 'fail', 'counterexample': failure.detail}
+
+
+def self_test():
+    source = PROJECT / 'limits.py'
+    baseline = run(source)
+    if baseline['status'] != 'pass':
+        return {'status': 'incomplete', 'baseline': baseline}, 1
+    original = source.read_text()
+    mutations = [
+        ('upper_bound', 'if not 1 <= parsed <= 255:', 'if not 1 <= parsed <= 256:', 'boundary_samples'),
+        ('length_bound', 'not 1 <= len(text) <= 3', 'not 1 <= len(text) <= 4', 'boundary_samples'),
+        ('ascii_guard', ' or not text.isascii()', '', 'boundary_samples'),
+        ('returned_value', 'return parsed', 'return parsed + 1', 'boundary_samples'),
+        ('type_guard', 'not isinstance(text, str) or ', '', 'non_string_samples'),
+    ]
+    results = []
+    with tempfile.TemporaryDirectory(prefix='mutation-', dir=HERE) as directory:
+        for name, before, after, expected_group in mutations:
+            if original.count(before) != 1:
+                raise RuntimeError(f'{name}: mutation anchor is absent or ambiguous; review changed source')
+            variant = Path(directory) / f'{name}.py'
+            variant.write_text(original.replace(before, after, 1))
+            result = run(variant)
+            detected = result['status'] == 'fail' and result['counterexample']['group'] == expected_group
+            results.append({'mutation': name, 'detected': detected, **result})
+    restored = run(source)
+    unchanged = source.read_text() == original
+    good = all(result['detected'] for result in results) and restored['status'] == 'pass' and unchanged
+    return {'status': 'pass' if good else 'incomplete', 'python': sys.version.split()[0],
+            'git': subprocess.check_output(['git', '--version'], text=True).strip(),
+            'head': subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=PROJECT, text=True).strip(),
+            'baseline': baseline, 'mutations': results, 'restored': restored,
+            'product_source_unchanged': unchanged}, 0 if good else 1
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--source', type=Path, default=PROJECT / 'limits.py')
+    parser.add_argument('--self-test', action='store_true')
+    args = parser.parse_args()
+    if args.self_test:
+        result, status = self_test()
+    else:
+        result = run(args.source.resolve())
+        status = 0 if result['status'] == 'pass' else 1
+    print(json.dumps(result, indent=2, ensure_ascii=True))
+    return status
+
+
+if __name__ == '__main__':
+    raise SystemExit(main())
