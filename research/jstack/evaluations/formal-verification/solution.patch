+"""Exhaustively check lease exclusivity using the repository's real transitions."""
+
+from collections import deque
+import importlib.util
+from pathlib import Path
+import sys
+
+
+def main():
+    root = Path(__file__).resolve().parents[3]
+    spec = importlib.util.spec_from_file_location("lease_under_check", root / "lease.py")
+    lease = importlib.util.module_from_spec(spec)
+    sys.modules[spec.name] = lease
+    spec.loader.exec_module(lease)
+    if lease.WORKERS != ("A", "B"):
+        raise ValueError("scope requires exactly workers A and B")
+
+    def validate(state):
+        if (type(state) is not lease.State
+                or set(vars(state)) != {"owner", "phases"}
+                or state.owner not in (None, "A", "B")
+                or type(state.phases) is not tuple
+                or len(state.phases) != 2
+                or any(p not in ("new", "ready", "holding", "done") for p in state.phases)):
+            raise ValueError(f"state outside reviewed 48-state domain: {state!r}")
+
+    initial = lease.State()
+    validate(initial)
+    if initial.owner is not None or initial.phases != ("new", "new"):
+        raise ValueError("initial state changed; review the proof scope")
+    parents = {initial: None}
+    pending = deque([initial])
+    transitions = 0
+    while pending:
+        state = pending.popleft()
+        if state.phases.count("holding") > 1:
+            steps = []
+            cursor = state
+            while parents[cursor] is not None:
+                previous, worker = parents[cursor]
+                steps.append((worker, cursor))
+                cursor = previous
+            print("FAIL: A and B both holding the exclusive lease")
+            print(f"start: {initial!r}")
+            for worker, successor in reversed(steps):
+                print(f"advance({worker}): {successor!r}")
+            print(f"discovered_states={len(parents)} evaluated_transitions={transitions}")
+            return 1
+        for worker in lease.WORKERS:
+            successor = lease.advance(state, worker)
+            transitions += 1
+            validate(successor)
+            if successor not in parents:
+                parents[successor] = (state, worker)
+                pending.append(successor)
+    print(f"PASS: at most one holder; reachable_states={len(parents)} "
+          f"evaluated_transitions={transitions}; domain_bound=48")
+    return 0
+
+
+if __name__ == "__main__":
+    try:
+        sys.exit(main())
+    except Exception as error:
+        print(f"INCOMPLETE: {type(error).__name__}: {error}", file=sys.stderr)
+        sys.exit(2)
