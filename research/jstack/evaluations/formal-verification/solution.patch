+"""Break the actual lease guard in an owned scratch copy, then restore it."""
+
+import argparse
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+import tempfile
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument("--scratch-root", required=True, type=Path)
+    args = parser.parse_args()
+    args.scratch_root.mkdir(parents=True, exist_ok=True)
+    skill = Path(__file__).resolve().parent
+    root = skill.parents[2]
+    original = (root / "lease.py").read_bytes()
+    needle = b'elif phase == "ready":\n        if owner is None:'
+    if original.count(needle) != 1:
+        raise RuntimeError("mutation no longer maps to the acquisition guard; update it")
+    with tempfile.TemporaryDirectory(prefix="lease-proof-", dir=args.scratch_root) as temp:
+        checkout = Path(temp)
+        checker = checkout / ".agents/skills/verify-lease-formal/check.py"
+        checker.parent.mkdir(parents=True)
+        shutil.copyfile(skill / "check.py", checker)
+        product = checkout / "lease.py"
+
+        def run(label, expected):
+            result = subprocess.run([sys.executable, "-B", str(checker)],
+                                    text=True, capture_output=True)
+            print(f"{label}: exit={result.returncode}")
+            print(result.stdout, end="")
+            print(result.stderr, end="", file=sys.stderr)
+            if result.returncode != expected:
+                raise RuntimeError(f"{label}: expected exit {expected}")
+            return result.stdout
+
+        product.write_bytes(original)
+        run("baseline copy", 0)
+        try:
+            product.write_bytes(original.replace(needle, b'elif phase == "ready":\n        if True:'))
+            output = run("removed acquisition recheck", 1)
+            if "phases=('holding', 'holding')" not in output:
+                raise RuntimeError("missing real exclusivity counterexample")
+        finally:
+            product.write_bytes(original)
+        run("restored copy", 0)
+        if product.read_bytes() != original or (root / "lease.py").read_bytes() != original:
+            raise RuntimeError("product restoration check failed")
+    print("PASS: real-code mutation detected; scratch restored; repository product unchanged")
+
+
+if __name__ == "__main__":
+    main()
